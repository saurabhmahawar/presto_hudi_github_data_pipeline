# Object Storage (Local MinIO - Zero-Cost, High-Performance, S3-Compatible)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_BUCKET_NAME=github-raw-data
S3_PATH_STYLE_ACCESS=true
S3_SSL_ENABLED=false

# Database Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PASSWORD=hivepassword

# Superset Configuration
SUPERSET_SECRET_KEY=superset_secret_key_for_lakehouse_visualization_12345

# Slack Pipeline Alerting Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK_URL
